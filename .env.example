# Copy to .env and edit. Every value has a working default in compose.yaml.

# Trustvian source to build the CLI and trustvian-local from: a branch, a tag
# or a commit SHA. Keep it on the same release as the collector image below.
TRUSTVIAN_REF=v0.11.0

# The Collector is not built: it comes from the signed release image, pinned
# by the digest of its multi-arch index (the v0.11.0 tag is informational).
TRUSTVIAN_COLLECTOR_IMAGE=ghcr.io/trustvian/trustvian-collector:v0.11.0@sha256:643532142a8ebeabb7504fd4b591c77615a4495e0e5c478462b40f865113bddc

# Host port of the WebUI / API (published on 127.0.0.1 only).
TRUSTVIAN_WEB_PORT=8080

# The model. graph.py uses ChatOllama against OLLAMA_URL while LLM_BASE_URL is
# empty, and ChatOpenAI against LLM_BASE_URL once it is set. It must support
# tool calling (`ollama show <model>` lists "tools"); gemma3 does not.
#   Ollama in Compose (default)   LLM_MODEL=qwen2.5:3b  OLLAMA_URL=http://ollama:11434   (pulled by ollama-pull on `up`)
#   Ollama on the host            LLM_MODEL=qwen2.5:3b  OLLAMA_URL=http://host.docker.internal:11434
#                                 (faster on a Mac: Metal. `ollama pull qwen2.5:3b` on the host yourself)
#   vLLM                          LLM_MODEL=<served-model-name>  LLM_BASE_URL=http://<host>:8000/v1  OPENAI_API_KEY=EMPTY
#   OpenAI                        LLM_MODEL=gpt-4o-mini  LLM_BASE_URL=https://api.openai.com/v1  OPENAI_API_KEY=<your key>
# Larger tool-capable Ollama models follow the prompt better: qwen2.5:7b, llama3.1:8b
# (give Docker Desktop >= 8 GB of memory for those).
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://ollama:11434
LLM_BASE_URL=
#OPENAI_API_KEY=

# ollama image tag and how long a loaded model stays in memory between runs.
#OLLAMA_TAG=latest
#OLLAMA_KEEP_ALIVE=30m

# Identity of what dev provisions on the control plane.
TRUSTVIAN_PROJECT=trustvian-langgraph-quickstart
TRUSTVIAN_AGENT=support-graph

# Content-free spans and no second tracer. compose.yaml defaults each to the
# value below; they are here so the whole configuration is in one place.
#   LANGSMITH_TRACING=false   LangChain's own tracer, off: it would send every
#                             prompt and completion to a hosted backend
#   OPENINFERENCE_HIDE_*      prompts, completions, messages and tool arguments
#                             stay out of the spans Trustvian receives
LANGSMITH_TRACING=false
OPENINFERENCE_HIDE_INPUTS=true
OPENINFERENCE_HIDE_OUTPUTS=true
OPENINFERENCE_HIDE_INPUT_MESSAGES=true
OPENINFERENCE_HIDE_OUTPUT_MESSAGES=true

# Live mode (`docker compose --profile live up -d`): three agents that keep
# working until stopped, each its own run. The defaults are compose.yaml's.
#   LIVE_AGENTS             the roles to run: support, billing, accounts
#   LIVE_INTERVAL_SECONDS   one ticket per agent this often, jittered +-50%
#   LIVE_DRIFT_EVERY        every Nth billing ticket also exports the record
#                           (a new behavior); 0 = never
#   LIVE_MAX_TICKETS        tickets per agent, then stop; 0 = until stopped
#   CRM_ERROR_RATE          share of CRM requests answered 503 (429 for
#                           refunds); 0 = never
#LIVE_AGENTS=support,billing,accounts
#LIVE_INTERVAL_SECONDS=10
#LIVE_DRIFT_EVERY=20
#LIVE_MAX_TICKETS=0
#CRM_ERROR_RATE=0.05
